rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization helpers
    function isAuth() {
      return request.auth != null;
    }

    function getAppUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
    }

    function isApproved(uid) {
      let u = getAppUser(uid);
      return u != null && u.active == true && (u.role == 'admin' || u.role == 'staff');
    }

    function isAdmin(uid) {
      let u = getAppUser(uid);
      return u != null && u.active == true && u.role == 'admin';
    }

    function staffCountTransitionIsValid(eventId, delta) {
      let before = get(/databases/$(database)/documents/events/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return after.studentParticipantCount == before.studentParticipantCount &&
        after.staffParticipantCount == before.staffParticipantCount + delta &&
        after.staffParticipantCount >= 0 &&
        after.participantCount == after.studentParticipantCount + after.staffParticipantCount &&
        after.hasDietaryRestrictions is bool &&
        after.updatedAt is timestamp;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isAuth() && (request.auth.uid == userId || isAdmin(request.auth.uid));

      // Only an active approved admin may create/update/delete user records
      allow create, update, delete: if isAuth() && isAdmin(request.auth.uid) &&
        // validate minimal shape
        request.resource.data.keys().hasAll(['email']) &&
        (request.resource.data.role == 'admin' || request.resource.data.role == 'staff') &&
        (request.resource.data.active is bool);
    }

    // Events: Admin and Staff (approved) may read/create/update
    match /events/{eventId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      allow create: if isAuth() && isApproved(request.auth.uid) &&
        // enforce createdByUserId matches the authenticated user
        request.resource.data.createdByUserId == request.auth.uid;

      allow update: if isAuth() && isApproved(request.auth.uid);

      // Hard deletes are not allowed in this milestone
      allow delete: if false;
    }

    // Activities
    match /activities/{activityId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update: if isAuth() && isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // Event types
    match /eventTypes/{eventTypeId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update: if isAuth() && isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // Students master data
    match /students/{studentId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      // Only active approved Admin users may create or update student master data
      allow create, update: if isAuth() && isAdmin(request.auth.uid) &&
        // basic validation
        request.resource.data.keys().hasAll(['firstName','lastName','displayName','grade','active']) &&
        (request.resource.data.grade is int) &&
        request.resource.data.grade >= 6 && request.resource.data.grade <= 12 &&
        (request.resource.data.active is bool);

      allow delete: if false;
    }

    // Staff master data
    match /staff/{staffId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      allow create: if isAuth() && isAdmin(request.auth.uid) &&
        request.resource.data.keys().hasAll(['staffId','firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['staffId','firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','createdAt','updatedAt']) &&
        request.resource.data.staffId == staffId &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() > 0 &&
        request.resource.data.dietaryRestrictions is list &&
        request.resource.data.active is bool && request.resource.data.canDrive is bool &&
        request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;

      allow update: if isAuth() && isAdmin(request.auth.uid) &&
        request.resource.data.staffId == resource.data.staffId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','updatedAt']) &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() > 0 &&
        request.resource.data.dietaryRestrictions is list &&
        request.resource.data.active is bool && request.resource.data.canDrive is bool &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    // Event participants
    match /eventParticipants/{participantId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      allow create: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.keys().hasAll(['eventId','studentId','status','addedByUserId','addedAt','removedByUserId','removedAt','notes']) &&
        request.resource.data.eventId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.addedByUserId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.removedByUserId == null &&
        request.resource.data.removedAt == null &&
        request.resource.data.notes == null || request.resource.data.notes is string &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.studentId &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.active == true;

      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.studentId == resource.data.studentId &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.studentId &&
        request.resource.data.status in ['active', 'removed'] &&
        request.resource.data.addedByUserId == request.auth.uid &&
        request.resource.data.addedAt is timestamp &&
        request.resource.data.removedByUserId == null || request.resource.data.removedByUserId == request.auth.uid &&
        request.resource.data.removedAt == null || request.resource.data.removedAt is timestamp &&
        (
          (
            resource.data.status == 'active' &&
            request.resource.data.status == 'removed' &&
            request.resource.data.removedByUserId == request.auth.uid &&
            request.resource.data.removedAt is timestamp &&
            request.resource.data.removedAt != null
          ) || (
            resource.data.status == 'removed' &&
            request.resource.data.status == 'active' &&
            request.resource.data.removedByUserId == null &&
            request.resource.data.removedAt == null &&
            request.resource.data.addedByUserId == request.auth.uid
          )
        );

      allow delete: if false;
    }

    // Staff-event participant relationships
    match /eventStaffParticipants/{participantId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      allow create: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.keys().hasAll(['eventStaffParticipantId','eventId','staffId','status','addedByUserId','addedAt','removedByUserId','removedAt','notes']) &&
        request.resource.data.keys().hasOnly(['eventStaffParticipantId','eventId','staffId','status','addedByUserId','addedAt','removedByUserId','removedAt','notes']) &&
        request.resource.data.eventStaffParticipantId == participantId &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.staffId &&
        request.resource.data.status == 'active' &&
        request.resource.data.addedByUserId == request.auth.uid && request.resource.data.addedAt is timestamp &&
        request.resource.data.removedByUserId == null && request.resource.data.removedAt == null &&
        (request.resource.data.notes == null || request.resource.data.notes is string) &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        exists(/databases/$(database)/documents/staff/$(request.resource.data.staffId)) &&
        get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.active == true &&
        staffCountTransitionIsValid(request.resource.data.eventId, 1);

      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventStaffParticipantId == resource.data.eventStaffParticipantId &&
        request.resource.data.eventId == resource.data.eventId && request.resource.data.staffId == resource.data.staffId &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.staffId &&
        request.resource.data.notes == resource.data.notes &&
        request.resource.data.status in ['active', 'removed'] &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        exists(/databases/$(database)/documents/staff/$(request.resource.data.staffId)) &&
        (
          (resource.data.status == 'active' && request.resource.data.status == 'removed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','removedByUserId','removedAt']) &&
            request.resource.data.addedByUserId == resource.data.addedByUserId && request.resource.data.addedAt == resource.data.addedAt &&
            request.resource.data.removedByUserId == request.auth.uid && request.resource.data.removedAt is timestamp &&
            staffCountTransitionIsValid(request.resource.data.eventId, -1)) ||
          (resource.data.status == 'removed' && request.resource.data.status == 'active' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','addedByUserId','addedAt','removedByUserId','removedAt']) &&
            get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.active == true &&
            request.resource.data.addedByUserId == request.auth.uid && request.resource.data.addedAt is timestamp &&
            request.resource.data.removedByUserId == null && request.resource.data.removedAt == null &&
            staffCountTransitionIsValid(request.resource.data.eventId, 1))
        );

      allow delete: if false;
    }

    // Allow other documented collections to be read/created only by approved users where appropriate.
    // For this milestone, deny access to any other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
