        validTripDriver(request.resource.data.returnDriverStaffId) &&
        validDepartureDriverParticipant(request.resource.data.eventId, request.resource.data.vehicleId, request.resource.data.departureDriverStaffId) &&
        validReturnDriverParticipant(request.resource.data.eventId, request.resource.data.vehicleId, request.resource.data.returnDriverStaffId) &&
        request.resource.data.returnDriverMirrorsDeparture is bool &&
        (!request.resource.data.returnDriverMirrorsDeparture || request.resource.data.returnDriverStaffId == request.resource.data.departureDriverStaffId) &&
        request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp &&
        request.resource.data.correctedAt == null && request.resource.data.correctedByUserId == null && request.resource.data.correctionReason == null;

      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventVehicleTripId == resource.data.eventVehicleTripId &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.vehicleId == resource.data.vehicleId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        tripId == request.resource.data.eventId + '__' + request.resource.data.vehicleId &&
        request.resource.data.assignmentStatus in ['active','removed'] &&
        request.resource.data.correctedAt == null && request.resource.data.correctedByUserId == null && request.resource.data.correctionReason == null &&
        request.resource.data.returnDriverMirrorsDeparture is bool &&
        resource.data.stage == 'planned' && request.resource.data.stage == 'planned' &&
        validTripDriver(request.resource.data.departureDriverStaffId) && validTripDriver(request.resource.data.returnDriverStaffId) &&
        validDepartureDriverParticipant(request.resource.data.eventId, request.resource.data.vehicleId, request.resource.data.departureDriverStaffId) && validReturnDriverParticipant(request.resource.data.eventId, request.resource.data.vehicleId, request.resource.data.returnDriverStaffId) &&
        (request.resource.data.assignmentStatus != 'active' || get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.active == true) &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.departedAt == null && nullOrMissing(request.resource.data, 'departedByUserId') && nullOrMissing(request.resource.data, 'departureSnapshot') &&
        request.resource.data.arrivedAtEventAt == null && nullOrMissing(request.resource.data, 'arrivedAtEventByUserId') && request.resource.data.returnStartedAt == null && nullOrMissing(request.resource.data, 'returnStartedByUserId') && nullOrMissing(request.resource.data, 'originalReturnSnapshot') && request.resource.data.returnedAt == null &&
        (!request.resource.data.returnDriverMirrorsDeparture || request.resource.data.returnDriverStaffId == request.resource.data.departureDriverStaffId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignmentStatus','departureDriverStaffId','returnDriverStaffId','returnDriverMirrorsDeparture','updatedAt']);

      allow delete: if false;
    }

    match /returnRosterCorrections/{correctionId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update, delete: if false;
    }

    match /returnDriverCorrections/{correctionId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update, delete: if false;
    }

    match /settings/transportation {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update: if isAuth() && isAdmin(request.auth.uid) &&
        request.resource.data.keys().hasAll(['defaultReturnDestination','updatedAt','updatedByUserId']) &&
        request.resource.data.keys().hasOnly(['defaultReturnDestination','updatedAt','updatedByUserId']) &&
        request.resource.data.defaultReturnDestination is string &&
        request.resource.data.defaultReturnDestination.size() > 0 &&
        request.resource.data.defaultReturnDestination.size() <= 200 &&
        request.resource.data.defaultReturnDestination.matches('^\\S.*') &&
        request.resource.data.defaultReturnDestination.matches('.*\\S$') &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedByUserId == request.auth.uid;
      allow delete: if false;
    }

    // Allow other documented collections to be read/created only by approved users where appropriate.
    // For this milestone, deny access to any other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
