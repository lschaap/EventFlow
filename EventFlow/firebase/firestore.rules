rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authorization helpers
    function isAuth() {
      return request.auth != null;
    }

    function getAppUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data
    }

    function isApproved(uid) {
      let u = getAppUser(uid);
      return u != null && u.active == true && (u.role == 'admin' || u.role == 'staff');
    }

    function isAdmin(uid) {
      let u = getAppUser(uid);
      return u != null && u.active == true && u.role == 'admin';
    }

    function nullOrMissing(data, field) {
      return !data.keys().hasAny([field]) || data[field] == null;
    }

    function staffCountTransitionIsValid(eventId, delta) {
      let before = get(/databases/$(database)/documents/events/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return after.studentParticipantCount >= before.studentParticipantCount &&
        after.staffParticipantCount >= before.staffParticipantCount + delta &&
        after.studentParticipantCount - before.studentParticipantCount <= 20 &&
        after.staffParticipantCount - before.staffParticipantCount <= 20 &&
        after.participantCount - before.participantCount <= 20 &&
        after.staffParticipantCount >= 0 &&
        after.participantCount == after.studentParticipantCount + after.staffParticipantCount &&
        after.hasDietaryRestrictions is bool &&
        after.updatedAt is timestamp;
    }

    function validDriverVehicle(vehicleId) {
      return vehicleId == null || (vehicleId is string && exists(/databases/$(database)/documents/vehicles/$(vehicleId)) && get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.active == true);
    }

    function validTripDriver(staffId) {
      return staffId == null || (staffId is string &&
        exists(/databases/$(database)/documents/staff/$(staffId)) &&
        get(/databases/$(database)/documents/staff/$(staffId)).data.active == true &&
        get(/databases/$(database)/documents/staff/$(staffId)).data.canDrive == true);
    }

    function validDepartureDriverParticipant(eventId, vehicleId, staffId) {
      return staffId == null || (existsAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)) &&
        getAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)).data.departureVehicleId == vehicleId);
    }

    function validReturnDriverParticipant(eventId, vehicleId, staffId) {
      return staffId == null || (existsAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)) &&
        getAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)).data.status == 'active' &&
        getAfter(/databases/$(database)/documents/eventStaffParticipants/$(eventId + '__' + staffId)).data.returnVehicleId == vehicleId);
    }

    function departureDriverMoveIsValid(eventId, staffId, oldVehicleId, newVehicleId) {
      return oldVehicleId == newVehicleId || oldVehicleId == null ||
        !existsAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)) ||
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)).data.assignmentStatus != 'active' ||
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)).data.departureDriverStaffId != staffId;
    }

    function returnDriverMoveIsValid(eventId, staffId, oldVehicleId, newVehicleId) {
      return oldVehicleId == newVehicleId || oldVehicleId == null ||
        !existsAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)) ||
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)).data.assignmentStatus != 'active' ||
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + oldVehicleId)).data.returnDriverStaffId != staffId;
    }

    function validParticipantVehicle(eventId, vehicleId) {
      return vehicleId == null || (vehicleId is string &&
        existsAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)) &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.eventId == eventId &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.vehicleId == vehicleId &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.assignmentStatus == 'active' &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.stage == 'planned' &&
        exists(/databases/$(database)/documents/vehicles/$(vehicleId)) &&
        get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.active == true);
    }

    function currentParticipantVehicleIsPlanned(eventId, vehicleId) {
      return vehicleId == null || (exists(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)) &&
        get(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.assignmentStatus == 'active' &&
        get(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.stage == 'planned');
    }

    function returnVehicleIsEligible(eventId, vehicleId, afterStart) {
      return vehicleId == null || (vehicleId is string &&
        existsAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)) &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.assignmentStatus == 'active' &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.stage in (afterStart ? ['departed','arrived_at_event','return_started'] : ['departed','arrived_at_event']) &&
        exists(/databases/$(database)/documents/vehicles/$(vehicleId)) &&
        get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.active == true);
    }

    function currentReturnVehicleIsEligible(eventId, vehicleId, afterStart) {
      return vehicleId == null || (exists(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)) &&
        get(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.assignmentStatus == 'active' &&
        get(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.stage in (afterStart ? ['departed','arrived_at_event','return_started'] : ['departed','arrived_at_event']));
    }

    function tripTransitionsToDeparted(eventId, vehicleId) {
      let path = /databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId);
      return vehicleId is string && exists(path) && existsAfter(path) &&
        get(path).data.eventId == eventId && get(path).data.vehicleId == vehicleId &&
        get(path).data.assignmentStatus == 'active' && get(path).data.stage == 'planned' &&
        getAfter(path).data.assignmentStatus == 'active' && getAfter(path).data.stage == 'departed';
    }

    function validReturnVehicleAfterDepart(eventId, vehicleId) {
      return vehicleId is string &&
        existsAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)) &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.eventId == eventId &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.vehicleId == vehicleId &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.assignmentStatus == 'active' &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + vehicleId)).data.stage in ['planned', 'departed'];
    }

    function validStudentDepartInitialization(eventId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnVehicleId']) &&
        request.resource.data.departureVehicleId == resource.data.departureVehicleId &&
        tripTransitionsToDeparted(eventId, resource.data.departureVehicleId) &&
        request.resource.data.returnVehicleId == resource.data.departureVehicleId;
    }

    function validStaffDepartInitialization(eventId, staffId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnVehicleId']) &&
        request.resource.data.departureVehicleId == resource.data.departureVehicleId &&
        tripTransitionsToDeparted(eventId, resource.data.departureVehicleId) &&
        validReturnVehicleAfterDepart(eventId, request.resource.data.returnVehicleId) &&
        (request.resource.data.returnVehicleId == resource.data.departureVehicleId ||
          getAfter(/databases/$(database)/documents/eventVehicleTrips/$(eventId + '__' + request.resource.data.returnVehicleId)).data.returnDriverStaffId == staffId);
    }

    function validFirstDepartEventTransition(eventId) {
      return resource.data.status == 'confirmed' && request.resource.data.status == 'in_progress' &&
        request.resource.data.startedAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.startedByUserId == request.auth.uid &&
        request.resource.data.startedByVehicleTripId is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt','startedByUserId','startedByVehicleTripId','updatedAt']) &&
        tripTransitionsToDeparted(eventId, getAfter(/databases/$(database)/documents/eventVehicleTrips/$(request.resource.data.startedByVehicleTripId)).data.vehicleId) &&
        request.resource.data.startedByVehicleTripId == getAfter(/databases/$(database)/documents/eventVehicleTrips/$(request.resource.data.startedByVehicleTripId)).data.eventVehicleTripId;
    }

    function validDepartureSnapshot(snapshot, vehicleId, driverStaffId) {
      return snapshot is map &&
        snapshot.keys().hasAll(['vehicleId','vehicleName','driverStaffId','driverName','studentOccupantIds','studentOccupantNames','staffOccupantIds','staffOccupantNames','studentCount','staffCount','totalOccupants','vehicleCapacity','overCapacity']) &&
        snapshot.keys().hasOnly(['vehicleId','vehicleName','driverStaffId','driverName','studentOccupantIds','studentOccupantNames','staffOccupantIds','staffOccupantNames','studentCount','staffCount','totalOccupants','vehicleCapacity','overCapacity']) &&
        snapshot.vehicleId == vehicleId && snapshot.driverStaffId == driverStaffId &&
        snapshot.vehicleName == get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.name &&
        snapshot.vehicleCapacity == get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.capacity &&
        snapshot.driverName == get(/databases/$(database)/documents/staff/$(driverStaffId)).data.displayName &&
        snapshot.vehicleName is string && snapshot.vehicleName.size() > 0 && snapshot.driverName is string && snapshot.driverName.size() > 0 &&
        snapshot.studentOccupantIds is list && snapshot.studentOccupantNames is list && snapshot.staffOccupantIds is list && snapshot.staffOccupantNames is list &&
        snapshot.studentCount is int && snapshot.staffCount is int && snapshot.totalOccupants is int && snapshot.vehicleCapacity is int &&
        snapshot.studentCount == snapshot.studentOccupantIds.size() && snapshot.studentCount == snapshot.studentOccupantNames.size() &&
        snapshot.staffCount == snapshot.staffOccupantIds.size() && snapshot.staffCount == snapshot.staffOccupantNames.size() &&
        snapshot.totalOccupants == snapshot.studentCount + snapshot.staffCount && snapshot.vehicleCapacity > 0 &&
        snapshot.overCapacity is bool && snapshot.overCapacity == (snapshot.totalOccupants > snapshot.vehicleCapacity);
    }

    function validOriginalReturnSnapshot(snapshot, vehicleId, driverStaffId) {
      return snapshot is map &&
        snapshot.keys().hasAll(['vehicleId','vehicleName','driverStaffId','driverName','studentOccupantIds','studentOccupantNames','staffOccupantIds','staffOccupantNames','studentCount','staffCount','totalOccupants','vehicleCapacity','overCapacity','destination','startedByUserId','startedAt']) &&
        snapshot.keys().hasOnly(['vehicleId','vehicleName','driverStaffId','driverName','studentOccupantIds','studentOccupantNames','staffOccupantIds','staffOccupantNames','studentCount','staffCount','totalOccupants','vehicleCapacity','overCapacity','destination','startedByUserId','startedAt']) &&
        snapshot.vehicleId == vehicleId && snapshot.driverStaffId == driverStaffId &&
        snapshot.vehicleName == get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.name &&
        snapshot.vehicleCapacity == get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.capacity &&
        snapshot.driverName == get(/databases/$(database)/documents/staff/$(driverStaffId)).data.displayName &&
        snapshot.studentOccupantIds is list && snapshot.studentOccupantNames is list && snapshot.staffOccupantIds is list && snapshot.staffOccupantNames is list &&
        snapshot.studentCount is int && snapshot.staffCount is int && snapshot.totalOccupants is int && snapshot.vehicleCapacity is int &&
        snapshot.studentCount == snapshot.studentOccupantIds.size() && snapshot.studentCount == snapshot.studentOccupantNames.size() &&
        snapshot.staffCount == snapshot.staffOccupantIds.size() && snapshot.staffCount == snapshot.staffOccupantNames.size() &&
        snapshot.totalOccupants == snapshot.studentCount + snapshot.staffCount && snapshot.vehicleCapacity > 0 &&
        snapshot.overCapacity is bool && snapshot.overCapacity == (snapshot.totalOccupants > snapshot.vehicleCapacity) &&
        snapshot.destination is string && snapshot.destination.size() > 0 &&
        snapshot.destination == (exists(/databases/$(database)/documents/settings/transportation) ? get(/databases/$(database)/documents/settings/transportation).data.defaultReturnDestination : 'Mill Village') &&
        snapshot.startedByUserId == request.auth.uid && snapshot.startedAt == request.time;
    }

    function validEventStateAfterDepart(eventId, tripId) {
      let before = get(/databases/$(database)/documents/events/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return (before.status == 'confirmed' && after.status == 'in_progress' && after.startedAt == request.time &&
          after.startedByUserId == request.auth.uid && after.startedByVehicleTripId == tripId) ||
        (before.status == 'in_progress' && after == before);
    }

    function validEventStateForArrival(eventId) {
      let before = get(/databases/$(database)/documents/events/$(eventId)).data;
      let after = getAfter(/databases/$(database)/documents/events/$(eventId)).data;
      return before.status == 'in_progress' && after == before &&
        before.startedAt is timestamp && before.startedByUserId is string && before.startedByVehicleTripId is string;
    }

    function validEventStatus(status) {
      return status in ['draft', 'confirmed', 'in_progress', 'completed', 'cancelled'];
    }

    function eventIsStructurallyValid(data) {
      return data.name is string && data.name.size() > 0 &&
        data.activityId is string && data.activityId.size() > 0 &&
        data.eventTypeId is string && data.eventTypeId.size() > 0 &&
        data.departureDateTime is timestamp && data.returnDateTime is timestamp &&
        data.returnDateTime > data.departureDateTime &&
        data.location is string && data.location.size() > 0;
    }

    function eventStatusTransitionIsValid() {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == 'draft' && request.resource.data.status == 'confirmed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
          eventIsStructurallyValid(request.resource.data)) ||
        validFirstDepartEventTransition(resource.data.eventId) ||
        ((resource.data.status == 'draft' || resource.data.status == 'confirmed') && request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','updatedAt'])) ||
        ((resource.data.status == 'draft' || resource.data.status == 'confirmed') && request.resource.data.status == 'completed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','updatedAt']));
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isAuth() && (request.auth.uid == userId || isAdmin(request.auth.uid));

      // Only an active approved admin may create/update/delete user records
      allow create, update, delete: if isAuth() && isAdmin(request.auth.uid) &&
        // validate minimal shape
        request.resource.data.keys().hasAll(['email']) &&
        (request.resource.data.role == 'admin' || request.resource.data.role == 'staff') &&
        (request.resource.data.active is bool);
    }

    // Events: Admin and Staff (approved) may read/create/update
    match /events/{eventId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      // Keep the first-Depart event transition on a compact authorization path.
      // The general event-update policy also supports CRUD and can exceed the
      // Rules expression budget when evaluated with a multi-document Depart.
      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventId == resource.data.eventId &&
        validFirstDepartEventTransition(eventId);

      allow create: if isAuth() && isApproved(request.auth.uid) &&
        // enforce createdByUserId matches the authenticated user
        request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.eventId == eventId &&
        request.resource.data.status == 'draft';

      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.createdByUserId == resource.data.createdByUserId &&
        request.resource.data.createdByUserName == resource.data.createdByUserName &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is timestamp &&
        validEventStatus(request.resource.data.status) &&
        eventStatusTransitionIsValid();

      // Hard deletes are not allowed in this milestone
      allow delete: if false;
    }

    // Activities
    match /activities/{activityId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update: if isAuth() && isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // Event types
    match /eventTypes/{eventTypeId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create, update: if isAuth() && isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // Students master data
    match /students/{studentId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      // Only active approved Admin users may create or update student master data
      allow create, update: if isAuth() && isAdmin(request.auth.uid) &&
        // basic validation
        request.resource.data.keys().hasAll(['firstName','lastName','displayName','grade','active']) &&
        (request.resource.data.grade is int) &&
        request.resource.data.grade >= 6 && request.resource.data.grade <= 12 &&
        (request.resource.data.active is bool);

      allow delete: if false;
    }

    // Staff master data
    match /staff/{staffId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      allow create: if isAuth() && isAdmin(request.auth.uid) &&
        request.resource.data.keys().hasAll(['staffId','firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['staffId','firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','createdAt','updatedAt']) &&
        request.resource.data.staffId == staffId &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() > 0 &&
        request.resource.data.dietaryRestrictions is list &&
        request.resource.data.active is bool && request.resource.data.canDrive is bool &&
        request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;

      allow update: if isAuth() && isAdmin(request.auth.uid) &&
        request.resource.data.staffId == resource.data.staffId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','displayName','email','roleTitle','dietaryRestrictions','active','canDrive','updatedAt']) &&
        request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 &&
        request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 &&
        request.resource.data.roleTitle is string && request.resource.data.roleTitle.size() > 0 &&
        request.resource.data.dietaryRestrictions is list &&
        request.resource.data.active is bool && request.resource.data.canDrive is bool &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuth() && isApproved(request.auth.uid);
      allow create: if isAuth() && isAdmin(request.auth.uid) && request.resource.data.keys().hasOnly(['vehicleId','name','capacity','active','createdAt','updatedAt']) && request.resource.data.keys().hasAll(['vehicleId','name','capacity','active','createdAt','updatedAt']) && request.resource.data.vehicleId == vehicleId && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.capacity is int && request.resource.data.capacity > 0 && request.resource.data.active is bool && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow update: if isAuth() && isAdmin(request.auth.uid) && request.resource.data.vehicleId == resource.data.vehicleId && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','capacity','active','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.capacity is int && request.resource.data.capacity > 0 && request.resource.data.active is bool && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Event participants
    match /eventParticipants/{participantId} {
      allow read: if isAuth() && isApproved(request.auth.uid);

      // Compact first assignment from Unassigned to one active planned vehicle.
      // Student return transportation mirrors departure before Depart.
      allow update: if isAuth() && isApproved(request.auth.uid) &&
        resource.data.status == 'active' && request.resource.data.status == 'active' &&
        participantId == resource.data.eventId + '__' + resource.data.studentId &&
        resource.data.departureVehicleId == null && resource.data.returnVehicleId == null &&
        request.resource.data.departureVehicleId is string && request.resource.data.returnVehicleId == request.resource.data.departureVehicleId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['departureVehicleId','returnVehicleId']) &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(resource.data.eventId + '__' + request.resource.data.departureVehicleId)).data.assignmentStatus == 'active' &&
        getAfter(/databases/$(database)/documents/eventVehicleTrips/$(resource.data.eventId + '__' + request.resource.data.departureVehicleId)).data.stage == 'planned';

      allow update: if isAuth() && isApproved(request.auth.uid) && resource.data.status == 'active' && request.resource.data.status == 'active' &&
        participantId == resource.data.eventId + '__' + resource.data.studentId &&
        request.resource.data.departureVehicleId == resource.data.departureVehicleId &&
        ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnVehicleId']) &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.status == 'in_progress' &&
          currentReturnVehicleIsEligible(resource.data.eventId, resource.data.returnVehicleId, false) && returnVehicleIsEligible(resource.data.eventId, request.resource.data.returnVehicleId, false)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnVehicleId']) &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.status == 'in_progress' &&
          currentReturnVehicleIsEligible(resource.data.eventId, resource.data.returnVehicleId, true) && returnVehicleIsEligible(resource.data.eventId, request.resource.data.returnVehicleId, true)));

      allow create: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.keys().hasAll(['eventId','studentId','status','addedByUserId','addedAt','removedByUserId','removedAt','notes','departureVehicleId','returnVehicleId']) &&
        request.resource.data.eventId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.addedByUserId == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.removedByUserId == null &&
        request.resource.data.removedAt == null &&
        request.resource.data.departureVehicleId == null && request.resource.data.returnVehicleId == null &&
        (request.resource.data.notes == null || request.resource.data.notes is string) &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.studentId &&
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
        exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.active == true;

      allow update: if isAuth() && isApproved(request.auth.uid) &&
        request.resource.data.eventId == resource.data.eventId &&
        request.resource.data.studentId == resource.data.studentId &&
        participantId == request.resource.data.eventId + '__' + request.resource.data.studentId &&
        request.resource.data.status in ['active', 'removed'] &&
        (request.resource.data.addedByUserId == resource.data.addedByUserId || request.resource.data.addedByUserId == request.auth.uid) &&
        request.resource.data.addedAt is timestamp &&
        (request.resource.data.removedByUserId == null || request.resource.data.removedByUserId == request.auth.uid || request.resource.data.removedByUserId == resource.data.removedByUserId) &&
