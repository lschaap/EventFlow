{
  "name": "eventflow-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test:migration": "npm run build && node lib/migrations/legacyDriverMigration.test.js",
    "test:rules-policy": "npm run build && node lib/firestoreRulesPolicy.test.js",
    "test:legacy-isolation": "npm run build && node lib/legacyIsolation.test.js",
    "test:reset-safeguards": "npm run build && node lib/resetOperationalTestData.test.js",
    "migrate:event-drivers": "npm run build && node lib/migrations/migrateLegacyDrivers.js",
    "reset:test-data": "npm run build && node lib/resetOperationalTestDataCli.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0",
    "googleapis": "^150.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
